#===================================
# Solver
#===================================
dt                       = 5               # Defines the time step size to solve the numeric equations for. NOTE: [us]
tend                     = 500             # Defines the point in time when the simulation stops.                 [ms]

#===================================
# Output
#===================================
timedt                   = 5              # Defines the temporal interval between progress updates made to the terminal. (For informational purposes only).
spacedt                  = 2              # Defines the temporal interval to output data to files.
gridout_i                = 0

#===================================
# LAT
#===================================
num_LATs                 = 2              # Number of events to detect

# Event 1: activation
lats[0].ID               = ACT
lats[0].measurand        = 0              # Defines the quantity to measure, e.g. the signal (0: Vm, 1: Phi_e) to use the thresholds on.
lats[0].all              = 0
lats[0].threshold        = -10            # Defines the crossing threshold (for method 1) or maximum derivative threshold (for method 2).
lats[0].mode             = 0              # Detect 0: max derivative or +slope threshold crossing, 1: min derivative or -slope threshold crossing

# Event 2: repolarization
lats[1].ID               = REP
lats[1].measurand        = 0
lats[1].all              = 0
lats[1].threshold        = -70
lats[1].mode             = 1
